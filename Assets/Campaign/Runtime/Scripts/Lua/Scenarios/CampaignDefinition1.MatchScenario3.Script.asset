  m_Script: {fileID: 11500000, guid: 16e61d0f4c8654e6fb94b45e4f0f866a, type: 3}
  m_Name: CampaignDefinition1.MatchScenario3.Script
  m_EditorClassIdentifier: Lua.Unity::Lua.Unity.LuaScript
  text: "\r\nlocal StandardChessMatchFactory = require(\"Factories/StandardChessMatchFactory.lua\")\r\nlocal
    CampaignFactory = require(\"Factories/CampaignFactory.lua\")\r\n\r\nlocal Scenario
    = { }\r\n\r\nfunction Scenario.setUp()\r\n    local boardHeight = 8\r\n    local
    boardWidth = 8\r\n    local deploymentZones =\r\n    {\r\n        Vector2Int.new(4,
    1),\r\n        Vector2Int.new(5, 1)\r\n    }\r\n\r\n    -- Create Board\r\n   
    StandardChessMatchFactory.createBoard(boardHeight, boardWidth)\r\n    \r\n   
    -- Add Enemy Units\r\n    StandardChessMatchFactory.addBlackKing(Vector2Int.new(4,
    8))\r\n    \r\n    -- Load Player's Units\r\n    CampaignFactory.loadPlayerCurrentUnits(deploymentZones)\r\n   
    \r\n    -- Set Starting Player\r\n    StandardChessMatchFactory.setStartingPlayer(\"White\")\r\nend\r\n\r\nfunction
    Scenario.load()\r\n    StandardChessMatchFactory.createHumanWhitePlayer()\r\n   
    StandardChessMatchFactory.createAIBlackPlayer({\r\n        difficulty = \"Medium\"\r\n   
    })\r\nend\r\n\r\nreturn Scenario"
